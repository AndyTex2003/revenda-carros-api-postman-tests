{
  "name": "revenda-carros-api-postman-tests",
  "version": "1.0.0",
  "description": "Automação de testes de API REST com Postman e Newman utilizando a Revenda de Carros API.",
  "main": "index.js",
  "scripts": {
    "test": "newman run collections/revenda-carros-api.postman_collection.json -e environments/local.postman_environment.json",
    "test:report": "newman run collections/revenda-carros-api.postman_collection.json -e environments/local.postman_environment.json -r cli,htmlextra --reporter-htmlextra-export reports/newman-report.html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndyTex2003/revenda-carros-api-postman-tests.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AndyTex2003/revenda-carros-api-postman-tests/issues"
  },
  "homepage": "https://github.com/AndyTex2003/revenda-carros-api-postman-tests#readme",
  "devDependencies": {
    "newman": "^6.2.3",
    "newman-reporter-htmlextra": "^1.23.1"
  }
}
